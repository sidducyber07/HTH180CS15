# PhishGuard Web - Environment Configuration
# Native Zero-Dependency Backend

# Server Binding
# Default: 127.0.0.1 (use 0.0.0.0 or all to bind to all network interfaces)
HOST=127.0.0.1
PORT=8787

# VirusTotal v3 API Key
# Provide your VirusTotal v3 API key below.
# If left blank, VirusTotal checks will mark URLs as unverified ('VirusTotal' in unverifiedBy)
# without defaulting them to safe (Strict Tri-State Contract).
VIRUSTOTAL_API_KEY=

# OpenPhish Feed URL
# Default community public text feed
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# Feed Refresh Interval in minutes (default: 360 minutes = 6 hours)
FEED_REFRESH_MINUTES=360
